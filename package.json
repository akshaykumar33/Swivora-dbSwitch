{
  "name": "morphdb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MorphDB - Universal Data Abstraction Layer (Write Once. Connect Everywhere.)",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "clean": "node scripts/clean.mjs",
    "bootstrap": "node scripts/clean.mjs && pnpm install && turbo run build",
    "fresh": "node scripts/clean.mjs && pnpm install",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "tsup": "^8.0.0",
    "vitest": "^1.5.0",
    "rimraf": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
